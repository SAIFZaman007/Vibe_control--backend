# ---------------------------------------------------------------------------
# Vibe Control — backend environment
# ---------------------------------------------------------------------------

# Core
APP_NAME=Vibe Control
ENVIRONMENT=development
DEBUG=true

# Database — async drivers.
#   Local dev (SQLite):  sqlite+aiosqlite:///./vibe_control.db
#   Production (Postgres/asyncpg):
#     postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./vibe_control.db

# Security
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — the frontend origin(s), comma-separated
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=15
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# AI style engine: tfhub | pillow | replicate
# - pillow: no extra install, instant, good for first run/demo
# - tfhub:  real neural style transfer (run `uv sync --extra ai` first)
# - replicate: paid API (set REPLICATE_API_TOKEN and `uv sync --extra paid`)
STYLE_ENGINE=pillow
STYLE_OUTPUT_MAX_DIM=1024
REPLICATE_API_TOKEN=

# SMTP / email (6-digit signup codes).
#   false -> codes are printed to the server log (handy for local dev)
#   true  -> codes are emailed via the SMTP settings below.
# For Gmail, use an App Password (requires 2FA) as SMTP_PASSWORD.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Vibe Control <no-reply@vibecontrol.app>
SMTP_TLS=true